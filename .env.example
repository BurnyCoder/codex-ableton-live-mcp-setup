# ABLETON_MCP_PORT="8765"
# CODEX_MCP_SERVER_NAME="ableton-live-mcp"
# CODEX_MCP_STARTUP_TIMEOUT_SEC="30"
# CODEX_MCP_TOOL_TIMEOUT_SEC="120"
# CODEX_MCP_APPROVAL_MODE="approve"

