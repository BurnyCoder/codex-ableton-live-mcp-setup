# Global context: optional non-secret overrides for the Windows setup; command arguments take precedence over these values.
# Copy this file to .env, then uncomment only values that differ from automatic discovery or defaults.
# Use forward slashes and quotes for Windows paths, especially paths containing spaces.

# ABLETON_SETUP_CHECKOUT="D:/MCP/ableton-live-mcp"
# ABLETON_USER_LIBRARY="D:/Ableton/User Library"
